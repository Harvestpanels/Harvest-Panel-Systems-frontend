# Copy to .env.local. All VITE_ values are public build-time configuration.
# Never use a Supabase service-role or secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional category-only reporting; production builds only. No paid service needed.
VITE_ERROR_REPORTING_ENABLED=false

# Server-only Vercel Function environment. Never prefix these with VITE_.
# Vite dev/preview does not serve /api/client-error.
CLIENT_ERROR_LOGGING_ENABLED=false
# Exact origins, comma-separated, no trailing slash. Empty fails closed.
CLIENT_ERROR_ALLOWED_ORIGINS=
