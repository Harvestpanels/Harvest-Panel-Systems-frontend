# Copy to .env.local and fill in from Supabase > Settings > API Keys.
# .env.local is gitignored; never commit real values.
#
# Both are safe in the browser: the publishable key grants nothing on its own,
# because Row Level Security decides what each signed-in user may read.
# Do NOT put the service_role / secret key here — it bypasses every policy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
